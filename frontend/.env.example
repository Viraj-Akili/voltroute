# VoltRoute Google Maps Platform & API Configuration
# Get your Google Maps API key from https://console.cloud.google.com/google/maps-apis/credentials
# For prototyping without billing, get a Maps Demo Key from https://mapsplatform.google.com/maps-demo-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Backend FastAPI URL (default: http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000
